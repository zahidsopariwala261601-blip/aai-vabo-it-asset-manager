# ─── Server ─────────────────────────────────────────────────────
PORT=8001
NODE_ENV=production

# ─── Database ───────────────────────────────────────────────────
# Local development: relative path
# Railway/Production: set to a path inside your mounted volume, e.g. /data/database.db
DB_PATH=./database.db

# ─── Security ───────────────────────────────────────────────────
# IMPORTANT: Generate a strong random secret. Example (PowerShell):
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# CORS: comma-separated allowed origins, or * for public access
ALLOWED_ORIGINS=*

# ─── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
