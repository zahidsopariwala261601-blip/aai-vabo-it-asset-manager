# Application Configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=your_secure_jwt_secret_key_change_me_in_production

# Database Configuration (Dual-Mode: SQLite or Supabase)
# Set DB_TYPE=supabase and supply DATABASE_URL to connect to Supabase PostgreSQL
DB_TYPE=supabase
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase API Credentials (Optional)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
